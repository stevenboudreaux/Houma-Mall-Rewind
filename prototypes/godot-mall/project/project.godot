; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Houma Mall Rewind"
run/main_scene="res://wing1.tscn"
run/main_scene.wing2="res://wing2.tscn"
run/main_scene.wing3="res://wing3.tscn"
run/main_scene.w1y26="res://wing1_2026.tscn"
run/main_scene.w2y26="res://wing2_2026.tscn"
run/main_scene.w3y26="res://wing3_2026.tscn"
run/main_scene.wing4="res://wing4.tscn"
run/main_scene.w4y26="res://wing4_2026.tscn"
run/main_scene.wing5="res://wing5.tscn"
run/main_scene.w5y26="res://wing5_2026.tscn"
run/main_scene.wing6="res://wing6.tscn"
run/main_scene.w6y26="res://wing6_2026.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

SharedPacks="*res://scripts/shared_packs.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/dpi/allow_hidpi=false

[editor_plugins]

enabled=PackedStringArray("res://addons/autobake/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

textures/default_filters/anisotropic_filtering_level=3

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
